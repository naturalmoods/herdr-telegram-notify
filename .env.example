# Required. The token is a password — anyone holding it can post as your bot,
# so keep this file to yourself: chmod 600 .env
# Linux needs util-linux's flock; on macOS use brew install util-linux. Fixed
# Homebrew paths are searched even without the shell's PATH. Kernel locks keep
# concurrent hooks and background processes from overwriting shared state.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Everything below is optional; these are the defaults.
# Comments must be on their own line — anything after `=` is part of the value.
# An env var of the same name overrides the value here for that one run.
# A value that cannot be parsed is ignored and the default used, so run
# `herdr plugin action invoke doctor` after editing this: it names the typos.

# Telegram bot chats are not end-to-end encrypted. Mask common secret shapes in
# captured agent text, prompts, titles, screens, buttons and /full, /screen or
# /diff output. This is best-effort pattern matching, not a guarantee. Secret-named
# assignment values shorter than 8 characters stay unchanged. Set 0 if a false
# positive gets in the way; text already masked cannot be restored.
MASK_SECRETS=1

# Statuses that send a message (comma separated: done, blocked, working, idle).
NOTIFY_STATUSES=done,blocked

# Message parts. 1/true/yes/on to include, anything else to drop.
# The agent session's own title, e.g. "Fix the flaky CI job".
SHOW_TITLE=1
# The prompt this turn started from — the question it was actually answering,
# as opposed to the session summary the title carries. A slash command shows as
# its name. PROMPT_CHARS is where it gets cut.
SHOW_PROMPT=1
PROMPT_CHARS=120
# Workspace label and working directory.
SHOW_PROJECT=1
# Git branch checked out in that working directory.
SHOW_BRANCH=1
# Uncommitted work in that directory: files touched, lines added and removed,
# and how many files are new. Left out when the tree is clean or is not a repo.
SHOW_CHANGES=1
# How long it ran: the pane's working→done gap, or the turn the transcript
# recorded when this plugin was not running for all of it.
SHOW_DURATION=1
# Tokens the turn spent: generated output, context size at the end, and cost
# when the agent records one. Codex uses its token-count events; cached input is
# already included in context, and it records no cost.
SHOW_TOKENS=1
# Other plugins' agent metadata from the snapshot, as one 📊 line after ⏱.
# Empty is off. Use case-sensitive names in display order; a trailing * matches
# a prefix, sorted by name. * alone selects all; overlapping matches appear
# once. Empty values and this plugin's telegram token are always skipped.
# Values are masked and clipped to 200 characters; queued messages keep them
# and blocked reminders read current values. This is not transcript usage.
# Example: SHOW_AGENT_TOKENS=model,context,quota_5h_*
# Displays: 📊 Model Cedar · context 13% · 5h 25% 59m
SHOW_AGENT_TOKENS=
# The tools the turn used and how often, busiest four first — the shape of the
# work rather than its size. Off by default: it is a line most messages can do
# without, and the ✎ line above already says whether files changed.
SHOW_TOOLS=0
# Local time of the status change. Off by default — Telegram already stamps
# the message with its arrival time.
SHOW_TIMESTAMP=0
# The line that tells you where it happened: host, named tab, and the
# `herdr agent focus <pane>` command that takes you back to it.
SHOW_PANE=1
# Hostname in that line — worth dropping if you only ever run one machine.
SHOW_HOST=1
# What the other agents are doing right now: who is blocked, who is still
# working, how many are idle.
SHOW_HERD=1
# The agent's last message, read from its Claude transcript, pi session file or
# Codex rollout. Codex ids resolve under CODEX_HOME/sessions in Herdr's environment
# (default ~/.codex/sessions), searching newest days first. CODEX_HOME is not a
# plugin .env setting. Codex prompts come from user-message events, not injected
# user-role context. Task events supply duration; tool-call records supply tools.
SHOW_LAST_MESSAGE=1
# What the pane is showing when the agent is blocked — usually the question
# it is waiting on, which never reaches the transcript. When the pane is split
# down the middle (an agent with a diff panel beside it), only the column the
# question is in is sent; the other one would interleave into it line by line.
SHOW_SCREEN_ON_BLOCKED=1

# Limits for the two body variants above. A last message past ~300 characters is
# sent collapsed, with Telegram's "show more" on it, which is why this is set
# well past what fits on a phone screen.
LAST_MESSAGE_CHARS=1200
SCREEN_LINES=12

# Shortest turn worth a message, in seconds. 0 sends for every turn. A turn you
# sat through does not need a notification, so raising this (60 is a sensible
# start) is the quickest way to make the ones you do get worth reading. Never
# applies to `blocked` — that message is a question waiting on you.
MIN_DURATION_SECONDS=0

# Wait before sending a blocked question, so an answer at the desk need not ring
# the phone. 0 sends at once; 15 is a sensible start. Capped at 120 seconds.
# Only the same blocked stretch, confirmed live after the wait, sends. The screen
# and buttons are read then. DRY_RUN skips the wait; reminder timing is unchanged.
BLOCKED_DELAY_SECONDS=0

# Nudge again about an agent still blocked this many minutes after it first
# said so — the message that gets missed is the one that arrived while you were
# reading something else. One nudge per blocked stretch, never a stream of them.
# 0 turns it off.
BLOCKED_REMINDER_MINUTES=0

# How often the queue and the reminders above are looked at on their own, in
# minutes. A blocked agent raises no further events — it is standing still — so
# without this its reminder, and the last message an outage queued, wait for some
# other pane to change status or close. Runs as a separate process when enabled,
# started when Herdr starts, or on the next status change after you turn it on.
# It stops on its next pass after you set it back to 0. Off by default: nothing
# runs in the background unasked. 5 is a sensible start.
SWEEP_MINUTES=0

# Hours to deliver without a sound, as HH:MM-HH:MM in this machine's local time
# (may run past midnight). The message still arrives and still waits in the chat
# unread — Telegram just does not ring for it. Empty means never.
QUIET_HOURS=

# Which workspaces may reach the phone. Comma separated, matched against the
# workspace label and its id, so `storefront` and `wA` both name the same one.
# NOTIFY_WORKSPACES empty means all of them; set it and only those listed send.
# IGNORE_WORKSPACES silences the ones listed, whatever the line above says.
# /new workspace@branch checks both the parent workspace and the branch label
# before creating a checkout; an allowlist needs to include the branch too.
NOTIFY_WORKSPACES=
IGNORE_WORKSPACES=

# Forum groups only: which topic the messages land in, so a workspace gets its
# own thread instead of everything sharing one stream. TELEGRAM_TOPIC_ID is the
# default for all of them; TELEGRAM_TOPICS overrides it per workspace, as
# `label-or-id:topic` pairs — e.g. `storefront:12,wB:15`. Leave both empty for a
# private chat or an ordinary group. To read a topic id, open the topic in
# Telegram Web: the number at the end of the URL is it.
TELEGRAM_TOPIC_ID=
TELEGRAM_TOPICS=

# How long the plugin's `mute` action silences it for, in minutes, and what a
# bare /mute in the chat uses. Invoking the action again before that lifts the
# mute; from the chat, /mute [minutes] sets it and /unmute lifts it. Muted
# messages are dropped, not held: the point is not to be told, rather than to be
# told all at once later.
MUTE_MINUTES=60

# Turn the notifications into a conversation: reply to one in Telegram and the
# text reaches the agent that message was about. A blocked agent gets it typed
# in and entered (so `1` picks the first option); any other agent takes it as a
# new turn. Only your own chat is listened to. A /stop reply sends Esc to that
# same agent session while working or blocked, without quitting it. A /screen
# reply reads up to 40 cropped lines from that session without sending input;
# SCREEN_LINES does not change this limit. A /diff reply downloads the same
# session's staged and unstaged changes, with untracked names only in the
# caption. It sends no input, disables external diff drivers and textconv, and
# explains diffs over 5 MB instead of sending them. /new <workspace>[@<branch>]
# <kind> [prompt] starts a real agent without needing a reply. Without @branch,
# it uses a new background tab; with it, a new Git worktree workspace labelled
# with the branch. The parent workspace must exist and pass the notification
# filters, as must the branch label before creation. Prompts keep their newlines
# and are capped at 4000 characters; no native agent options are passed.
# Reply to its confirmation once a session is known, otherwise to its first
# notification. A failed plain-tab start closes its new tab; a failed worktree
# start leaves the checkout intact and reports its workspace id and removal
# command. See the README before turning replies on, since people allowed to
# type into agents can also start them and create checkouts.
# The polling runs in its own process when enabled, started when Herdr starts,
# or on the next status change after you turn it on.
# Once the poller starts, it registers Telegram's "/" menu automatically; no
# command setup in BotFather is needed.
REPLIES=0

# Who may reply or run commands (including /new), as Telegram user ids
# separated by commas. Empty (the default)
# means anyone who can write in TELEGRAM_CHAT_ID — right for a private chat,
# where that is only you. In a group it is everyone in the group, so name the
# ids there. With a list set, a sender that cannot be named is refused: an
# anonymous admin and a channel post arrive without a usable user id. To read
# your id, message @userinfobot.
REPLY_ALLOWED_USER_IDS=

# Edit a notification once the agent has moved past it: a question answered at
# the keyboard reads "✓ answered", a finished turn you looked at "👀 seen at the
# desk". Closing its pane marks it "✕ pane closed". What still looks like a
# notification is what is still waiting on you.
MARK_RESOLVED=1

# Display-only telegram metadata; add "$telegram" to [ui.sidebar.agents] and
# [ui.sidebar.spaces] rows in Herdr config.toml to see it. 📨 means actually sent
# and clears with MARK_RESOLVED; 📱 means phone input, expiring after 30 minutes.
# Mute actions and /mute set 🔕 until HH:MM on current snapshot workspaces;
# unmute clears it. New workspaces during a mute get no badge automatically.
# Mute TTL uses remaining time, capped at Herdr's 24-hour limit; longer mutes
# still silence notifications. Reports are asynchronous, with a one-second
# timeout, DEBUG-only failure logs and sequence guards. DRY_RUN never reports.
# Setting 0 stops reports but does not clear existing values.
SIDEBAR_TOKENS=1

# Voice messages sent as replies are transcribed with a local whisper CLI
# (openai-whisper or whisper-ctranslate2) and passed on as text. Empty means
# look for one on PATH and in ~/.local/bin; without one, voice is refused.
# `base` is faster, `medium` hears non-English speech better.
WHISPER_BIN=
WHISPER_MODEL=small
# The language you speak, as a code whisper knows (hu, en, de). Empty means
# whisper guesses per message, and a short one can come back as the wrong
# language entirely.
WHISPER_LANGUAGE=

# One pinned message with the whole herd, edited in place on every status change
# and pane closure so it never rings. Closed panes disappear without needing the
# sweeper. In a group the bot needs admin rights to pin it.
BOARD=0

# Say why a run decided not to send. Most runs end without a message on purpose
# — a status nobody asked about, a pane already in that state — and this is what
# turns that silence into a line in `herdr plugin log list`.
DEBUG=0

# Print the message to stdout instead of sending it.
DRY_RUN=0
