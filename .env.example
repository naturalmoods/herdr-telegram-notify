# Required. The token is a password — anyone holding it can post as your bot,
# so keep this file to yourself: chmod 600 .env
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Everything below is optional; these are the defaults.
# Comments must be on their own line — anything after `=` is part of the value.
# An env var of the same name overrides the value here for that one run.

# Statuses that send a message (comma separated: done, blocked, working, idle).
NOTIFY_STATUSES=done,blocked

# Message parts. 1/true/yes/on to include, anything else to drop.
# The agent session's own title, e.g. "Fix the flaky CI job".
SHOW_TITLE=1
# Workspace label and working directory.
SHOW_PROJECT=1
# Git branch checked out in that working directory.
SHOW_BRANCH=1
# How long it ran: the pane's working→done gap, or the turn the transcript
# recorded when this plugin was not running for all of it.
SHOW_DURATION=1
# Tokens the turn spent: generated output, context size at the end, and cost
# when the agent records one.
SHOW_TOKENS=1
# Local time of the status change. Off by default — Telegram already stamps
# the message with its arrival time.
SHOW_TIMESTAMP=0
# The line that tells you where it happened: host, named tab, and the
# `herdr agent focus <pane>` command that takes you back to it.
SHOW_PANE=1
# Hostname in that line — worth dropping if you only ever run one machine.
SHOW_HOST=1
# What the other agents are doing right now: who is blocked, who is still
# working, how many are idle.
SHOW_HERD=1
# The agent's last message, read from its own transcript.
SHOW_LAST_MESSAGE=1
# What the pane is showing when the agent is blocked — usually the question
# it is waiting on, which never reaches the transcript.
SHOW_SCREEN_ON_BLOCKED=1

# Limits for the two body variants above.
LAST_MESSAGE_CHARS=600
SCREEN_LINES=12

# Print the message to stdout instead of sending it.
DRY_RUN=0
